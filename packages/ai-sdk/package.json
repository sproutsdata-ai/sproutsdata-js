{
  "name": "@sproutsdata.ai/ai-sdk",
  "version": "0.2.0",
  "description": "The Sprouts Data tools (search, look-alike and entity lookup) for the Vercel AI SDK.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sproutsdata-ai/sprouts-js.git",
    "directory": "packages/ai-sdk"
  },
  "homepage": "https://github.com/sproutsdata-ai/sprouts-js/tree/main/packages/ai-sdk#readme",
  "bugs": {
    "url": "https://github.com/sproutsdata-ai/sprouts-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "sproutsdata",
    "sprouts",
    "ai-sdk",
    "vercel",
    "ai",
    "tools",
    "agents",
    "search",
    "enrichment"
  ],
  "peerDependencies": {
    "ai": "^7.0.0",
    "sproutsdata": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ai": "^7.0.0",
    "sproutsdata": "^0.4.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
