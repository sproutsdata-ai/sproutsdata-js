        "X-Request-Id": "req_ok"
      },
      "body": {
        "results": [
          {
            "id": "a.com",
            "category": "company",
            "score": 1.0
          }
        ],
        "total": 1,
        "total_is_estimate": false,
        "has_more": false,
        "next_cursor": null,
        "resolved_search": null,
        "attribution": [],
        "degradation": [],
        "meta": {
          "request_id": "req_ok",
          "environment": "live",
          "as_of": "2026-11-11T00:00:00Z",
          "credential": "api_key"
        }
      }
    }
  ],
  "expect": {
    "attempts": 2,
    "sent": [
