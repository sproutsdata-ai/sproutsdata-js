{
  "name": "sproutsdata-js-monorepo",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "//": "LEGACY until their phase of the rewrite (zarkdown IMPLEMENTATION_PLAN.md): the two adapters (Phase 8) and the examples (Phase 9) are left out of typecheck and test. `npm run check` is the whole gate CI runs.",
  "scripts": {
    "check": "npm run lint && npm run lint:layers && npm run check:generated && npm run typecheck && npm run test && npm run build && npm run check:package && npm run check:size && npm run smoke:dist && npm run smoke:edge && npm run check:links && npm run audit",
    "lint": "eslint .",
    "lint:layers": "depcruise packages --config .dependency-cruiser.cjs",
    "typecheck": "npm run typecheck -w packages/sdk",
    "test": "npm run test -w packages/sdk",
    "build": "npm run build -w packages/sdk",
    "check:generated": "node scripts/sync-spec.mjs --check && node scripts/generate.mjs --check",
    "check:package": "publint packages/sdk --strict && attw --pack packages/sdk",
    "check:size": "size-limit",
    "check:links": "node scripts/check-links.mjs",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "smoke:edge": "node scripts/smoke-edge.mjs",
    "audit": "npm audit --omit=dev",
    "spec:sync": "node scripts/sync-spec.mjs",
    "generate": "node scripts/generate.mjs",
    "e2e": "npm run e2e -w packages/sdk"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "miniflare": "^4.20260730.0",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
