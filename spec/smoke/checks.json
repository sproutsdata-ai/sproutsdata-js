    { "name": "filter_values", "call": "GET /v1/search/filters/industry", "billed": false },
    { "name": "search.page_one", "call": "POST /v1/search", "billed": true },
    { "name": "search.page_two", "call": "POST /v1/search (cursor)", "billed": true },
