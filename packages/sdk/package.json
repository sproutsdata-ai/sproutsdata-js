{
  "name": "sproutsdata",
  "version": "0.0.1",
  "description": "Official JavaScript/TypeScript SDK for the Sprouts Data API: search, look-alike, entity lookups, relationships, org charts, agent runs, credits, usage history, feedback, and members.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sproutsdata-ai/sproutsdata-js.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/sproutsdata-ai/sproutsdata-js#readme",
  "bugs": {
    "url": "https://github.com/sproutsdata-ai/sproutsdata-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tools": {
      "import": {
        "types": "./dist/tools.d.ts",
        "default": "./dist/tools.js"
      },
      "require": {
        "types": "./dist/tools.d.cts",
        "default": "./dist/tools.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "tools": [
        "./dist/tools.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "sproutsdata",
    "sprouts",
    "b2b-data",
    "search",
    "entities",
    "enrichment",
    "sdk",
    "api-client"
  ],
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
