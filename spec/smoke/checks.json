    { "name": "history.metrics", "call": "GET /v1/usage/metrics", "billed": false },
    { "name": "feedback.tags", "call": "GET /v1/feedback/tags", "billed": false },
    { "name": "lists.round_trip", "call": "POST, GET, DELETE /v1/lists", "billed": false },
