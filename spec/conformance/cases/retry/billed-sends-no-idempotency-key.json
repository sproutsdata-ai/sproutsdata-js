{
  "name": "a_billed_call_sends_no_idempotency_key",
  "description": "Billed routes do not read Idempotency-Key (a repeated first page is a new paid session either way), so the SDK does not send one, on the first attempt or on a retry.",
  "responses": [
    {
      "status": 503,
      "headers": {
        "Retry-After": "0"
      },
      "body": {
        "type": "https://dashboard.sproutsdata.ai/errors/upstream-unavailable",
        "title": "Upstream unavailable",
        "status": 503,
        "code": "upstream.unavailable"
      }
    },
    {
      "status": 200,
      "headers": {
        "X-Request-Id": "req_ok"
      },
      "body": {
        "results": [
          {
            "id": "a.com",
            "category": "company",
            "score": 1.0
          }
        ],
        "total": 1,
        "total_is_estimate": false,
        "has_more": false,
        "next_cursor": null,
        "resolved_search": null,
        "attribution": [],
        "degradation": [],
        "meta": {
          "request_id": "req_ok",
          "environment": "test",
          "as_of": "2026-11-11T00:00:00Z",
          "credential": "api_key"
        }
      }
    }
  ],
  "expect": {
    "attempts": 2,
    "sent": [
      {
        "headers_absent": [
          "Idempotency-Key"
        ]
      },
      {
        "body_equals_index": 0,
        "headers_absent": [
          "Idempotency-Key"
        ]
      }
    ],
    "success": {
      "results_length": 1,
      "request_id": "req_ok"
    }
  }
}
