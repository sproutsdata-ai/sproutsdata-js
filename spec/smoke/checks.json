    { "name": "local.document_filters_refused", "call": "search(category=news_article, DiscoverFilters)", "billed": false },
    { "name": "credits.retrieve", "call": "GET /v1/credits", "billed": false },
    { "name": "credits.transactions", "call": "GET /v1/credits/transactions", "billed": false },
    { "name": "coverage", "call": "GET /v1/coverage", "billed": false },
