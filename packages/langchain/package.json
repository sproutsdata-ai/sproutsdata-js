{
  "name": "@sproutsdata.ai/langchain",
  "version": "0.0.1",
  "description": "The Sprouts Data tools (search, look-alike and entity lookup) and search retriever for LangChain.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sproutsdata-ai/sproutsdata-js.git",
    "directory": "packages/langchain"
  },
  "homepage": "https://github.com/sproutsdata-ai/sproutsdata-js/tree/main/packages/langchain#readme",
  "bugs": {
    "url": "https://github.com/sproutsdata-ai/sproutsdata-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "sproutsdata",
    "sprouts",
    "langchain",
    "retriever",
    "tools",
    "agents",
    "search",
    "enrichment"
  ],
  "peerDependencies": {
    "@langchain/core": "^1.0.0",
    "sproutsdata": ">=0.0.1 <0.1.0"
  },
  "devDependencies": {
    "@langchain/core": "^1.0.0",
    "@types/node": "^20.14.0",
    "sproutsdata": ">=0.0.1 <0.1.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
